local bike = script.Parent.Parent
local F = {}

bike.Misc.Anims.R15.RightArm.UpperArm.Parts.RightUpperArm.Parent = bike.Misc.Anims.R15
bike.Misc.Anims.R15.RightArm.LowerArm.Parts.RightLowerArm.Parent = bike.Misc.Anims.R15
bike.Misc.Anims.R15.RightArm.Hand.Parts.RightHand.Parent = bike.Misc.Anims.R15

bike.Misc.Anims.R15.RightLeg.UpperLeg.Parts.RightUpperLeg.Parent = bike.Misc.Anims.R15
bike.Misc.Anims.R15.RightLeg.LowerLeg.Parts.RightLowerLeg.Parent = bike.Misc.Anims.R15
bike.Misc.Anims.R15.RightLeg.Foot.Parts.RightFoot.Parent = bike.Misc.Anims.R15

