	   / /\ \______| |    | '_ \ / _` / __/ __| / __|
	  / ____ \     | |____| | | | (_| \__ \__ \ \__ \
	 /_/    \_\     \_____|_| |_|\__,_|___/___/_|___/
	 Version 1.7
--]]

local bike = script.Parent.Parent
local kickstand = bike.Misc.Kickstand

bike:WaitForChild("DriveSeat"):GetPropertyChangedSignal("Occupant"):Connect(function()
	kickstand.CanCollide = not (bike.DriveSeat.Occupant ~= nil)
end)

kickstand.CanCollide = not (bike.DriveSeat.Occupant ~= nil)
</string>
                  <int64 name="SourceAssetId">-1</int64>
