			if not v:IsA("BasePart") then
				v:Destroy()
			end
		end]]

				for i,v in pairs(bike.Misc.Anims.R15.NewHead:GetChildren()) do
					if v.Name == "face" or v.Name == "Mesh" then
						v.Parent = C.Head
					else
						v:Destroy()
					end
				end

				for i,v in pairs(bike.Misc.Anims.R15:GetChildren()) do
					if (not v:IsA("BasePart")) and (not v:IsA("Model")) then
						v:Destroy()
					end
				end



				bike.Misc.Anims.R15.RightUpperArm.Transparency = 1
				bike.Misc.Anims.R15.RightLowerArm.Transparency = 1
				bike.Misc.Anims.R15.RightHand.Transparency = 1

				bike.Misc.Anims.R15.RightUpperLeg.Transparency = 1
				bike.Misc.Anims.R15.RightLowerLeg.Transparency = 1
				bike.Misc.Anims.R15.RightFoot.Transparency = 1

				bike.Misc.Anims.R15.LeftUpperArm.Transparency = 1
				bike.Misc.Anims.R15.LeftLowerArm.Transparency = 1
				bike.Misc.Anims.R15.LeftHand.Transparency = 1

				bike.Misc.Anims.R15.LeftUpperLeg.Transparency = 1
				bike.Misc.Anims.R15.LeftLowerLeg.Transparency = 1
				bike.Misc.Anims.R15.LeftFoot.Transparency = 1

				bike.Misc.Anims.R15.LowerTorso.Transparency = 1
				bike.Misc.Anims.R15.UpperTorso.Transparency = 1

				bike.Misc.Anims.R15.NewHead.Transparency = 1

				for i,v in pairs(C:GetChildren()) do
					if v:IsA("Accessory") then		
						local Accessory = v.Handle:FindFirstChild("AccessoryWeld")
						if Accessory ~= nil and Accessory.Part1.Name == "NewHead" then
							Accessory.Part1 = C.Head
						elseif Accessory ~= nil and Accessory.Part1.Name == "UpperTorso" then
							Accessory.Part1 = C.UpperTorso
						elseif Accessory ~= nil and Accessory.Part1.Name == "LowerTorso" then
							Accessory.Part1 = C.LowerTorso
						end
					end
				end	

			end
		end

	end
end

script.Parent.OnServerEvent:connect(function(pl,Fnc,...)
	local character = select(1, ...)
	if character ~= pl.Character or not character then return end
	if Fnc ~= "CreatePlayer" and Fnc ~= "RemovePlayer" then return end
	if Fnc == "CreatePlayer" and bike.DriveSeat.Occupant ~= character:FindFirstChildOfClass("Humanoid") then return end
	F[Fnc](...)
end)</string>
