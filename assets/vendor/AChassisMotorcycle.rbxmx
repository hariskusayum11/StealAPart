F.CreatePlayer = function(C)

	if C.Humanoid.RigType == Enum.HumanoidRigType.R6 then

		C.Torso.Transparency = 1	
		C.Head.Transparency = 1	
		C["Right Arm"].Transparency = 1
		C["Left Arm"].Transparency = 1
		C["Right Leg"].Transparency = 1
		C["Left Leg"].Transparency = 1

		if C.Torso:FindFirstChild("Neck")~=nil then
			for i,v in pairs(bike.Misc.Anims.R6:GetChildren()) do
				if v:FindFirstChild("Parts") then
					if not v.Parts:FindFirstChild("Humanoid") then
						local hum = Instance.new("Humanoid")
						hum.AutoJumpEnabled = false
						hum.AutoRotate = false
						hum.Sit = true
						hum.Parent = v.Parts
					end
				end

				bike.Misc.Anims.R6.Head.Parts.NewHead.Transparency = 0
				bike.Misc.Anims.R6.Torso.Parts.Torso.Transparency = 0
				bike.Misc.Anims.R6.RightArm.Parts["Right Arm"].Transparency = 0
				bike.Misc.Anims.R6.LeftArm.Parts["Left Arm"].Transparency = 0
				bike.Misc.Anims.R6.RightLeg.Parts["Right Leg"].Transparency = 0
				bike.Misc.Anims.R6.LeftLeg.Parts["Left Leg"].Transparency = 0
			end

			for i,v in pairs(C:GetChildren()) do
				if v.Name == "Head" then
					if v:FindFirstChild("Mesh") then
						v.Mesh.Parent=bike.Misc.Anims.R6.Head.Parts.NewHead
					end
					if v:FindFirstChild("face") then
						v.face.Parent=bike.Misc.Anims.R6.Head.Parts.NewHead
					end
				end

				if v:IsA("Shirt") then
					v:Clone().Parent=bike.Misc.Anims.R6.Torso.Parts
					v:Clone().Parent=bike.Misc.Anims.R6.RightArm.Parts
					v:Clone().Parent=bike.Misc.Anims.R6.LeftArm.Parts
				end

				if v:IsA("Pants") then
					v:Clone().Parent=bike.Misc.Anims.R6.RightLeg.Parts
					v:Clone().Parent=bike.Misc.Anims.R6.LeftLeg.Parts
				end

				if v:IsA("BodyColors") then
					v:Clone().Parent=bike.Misc.Anims.R6.Torso.Parts
					v:Clone().Parent=bike.Misc.Anims.R6.RightArm.Parts
					v:Clone().Parent=bike.Misc.Anims.R6.LeftArm.Parts
					v:Clone().Parent=bike.Misc.Anims.R6.RightLeg.Parts
					v:Clone().Parent=bike.Misc.Anims.R6.LeftLeg.Parts
					bike.Misc.Anims.R6.Head.Parts.NewHead.Color = v.HeadColor3
				end

				if v:IsA("Accessory") then		
					local Accessory = v.Handle:FindFirstChild("AccessoryWeld")
					if Accessory ~= nil and Accessory.Part1.Name == "Head" then
						Accessory.Part1 = bike.Misc.Anims.R6.Head.Parts.NewHead
					elseif Accessory ~= nil and Accessory.Part1.Name == "Torso" then
						Accessory.Part1 = bike.Misc.Anims.R6.Torso.Parts.Torso
					end
				end
			end
		end
	else

		C.RightUpperArm.Transparency = 1
		C.RightLowerArm.Transparency = 1
		C.RightHand.Transparency = 1

		C.RightUpperLeg.Transparency = 1
		C.RightLowerLeg.Transparency = 1
		C.RightFoot.Transparency = 1

		C.LeftUpperArm.Transparency = 1
		C.LeftLowerArm.Transparency = 1
		C.LeftHand.Transparency = 1

		C.LeftUpperLeg.Transparency = 1
		C.LeftLowerLeg.Transparency = 1
		C.LeftFoot.Transparency = 1	

		C.LowerTorso.Transparency = 1
		C.UpperTorso.Transparency = 1

		C.Head.Transparency = 1

		if C.Head:FindFirstChild("Neck")~=nil then
