					end
					if v:FindFirstChild("face") then
						v.face.Parent=bike.Misc.Anims.R15.NewHead
					end
				end

				if v:IsA("Shirt") then
				--[[v:Clone().Parent=bike.Misc.Anims.R15.Torso.UpperTorso.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.Torso.LowerTorso.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.RightArm.LowerArm.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.RightArm.UpperArm.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.RightArm.Hand.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.LeftArm.LowerArm.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.LeftArm.UpperArm.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.LeftArm.Hand.Parts]]
					v:Clone().Parent=bike.Misc.Anims.R15
				end

				if v:IsA("Pants") then
				--[[v:Clone().Parent=bike.Misc.Anims.R15.RightLeg.UpperLeg.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.RightLeg.LowerLeg.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.RightLeg.Foot.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.LeftLeg.UpperLeg.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.LeftLeg.LowerLeg.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.LeftLeg.Foot.Parts]]
					v:Clone().Parent=bike.Misc.Anims.R15
				end

				if v:IsA("BodyColors") then
				--[[v:Clone().Parent=bike.Misc.Anims.R15.Torso.UpperTorso.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.Torso.LowerTorso.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.RightArm.LowerArm.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.RightArm.UpperArm.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.RightArm.Hand.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.LeftArm.LowerArm.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.LeftArm.UpperArm.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.LeftArm.Hand.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.RightLeg.UpperLeg.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.RightLeg.LowerLeg.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.RightLeg.Foot.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.LeftLeg.UpperLeg.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.LeftLeg.LowerLeg.Parts
				v:Clone().Parent=bike.Misc.Anims.R15.LeftLeg.Foot.Parts]]
					v:Clone().Parent=bike.Misc.Anims.R15
					bike.Misc.Anims.R15.NewHead.Color = v.HeadColor3
				end

				if v:IsA("Accessory") then		
					local Accessory = v.Handle:FindFirstChild("AccessoryWeld")
					if Accessory ~= nil and Accessory.Part1.Name == "Head" then
						Accessory.Part1 = bike.Misc.Anims.R15.NewHead
					elseif Accessory ~= nil and Accessory.Part1.Name == "UpperTorso" then
						Accessory.Part1 = bike.Misc.Anims.R15.UpperTorso
					elseif Accessory ~= nil and Accessory.Part1.Name == "LowerTorso" then
						Accessory.Part1 = bike.Misc.Anims.R15.LowerTorso
					end
				end
			end
		end

	end
end

F.RemovePlayer = function(C,child)

	if C.Humanoid.RigType == Enum.HumanoidRigType.R6 then

		if child.Name=="SeatWeld" then
			C.Torso.Transparency = 0	
			C.Head.Transparency = 0	
			C["Right Arm"].Transparency = 0
			C["Left Arm"].Transparency = 0
			C["Right Leg"].Transparency = 0
			C["Left Leg"].Transparency = 0

			bike.Misc.Anims.R6.Head.Parts.NewHead.Transparency = 1
			bike.Misc.Anims.R6.Torso.Parts.Torso.Transparency = 1
			bike.Misc.Anims.R6.RightArm.Parts["Right Arm"].Transparency = 1
			bike.Misc.Anims.R6.LeftArm.Parts["Left Arm"].Transparency = 1
			bike.Misc.Anims.R6.RightLeg.Parts["Right Leg"].Transparency = 1
			bike.Misc.Anims.R6.LeftLeg.Parts["Left Leg"].Transparency = 1

			for i,v in pairs(bike.Misc.Anims.R6.Torso.Parts:GetChildren()) do
				if not v:IsA("BasePart") then
					v:Destroy()
				end
			end

			for i,v in pairs(bike.Misc.Anims.R6.RightArm.Parts:GetChildren()) do
				if not v:IsA("BasePart") then
					v:Destroy()
				end
			end

			for i,v in pairs(bike.Misc.Anims.R6.LeftArm.Parts:GetChildren()) do
				if not v:IsA("BasePart") then
					v:Destroy()
				end
			end

			for i,v in pairs(bike.Misc.Anims.R6.RightLeg.Parts:GetChildren()) do
				if not v:IsA("BasePart") then
					v:Destroy()
				end
			end

			for i,v in pairs(bike.Misc.Anims.R6.LeftLeg.Parts:GetChildren()) do
				if not v:IsA("BasePart") then
					v:Destroy()
				end
			end

			if bike.Misc.Anims.R6.Head.Parts.NewHead:FindFirstChild("Mesh") then
				bike.Misc.Anims.R6.Head.Parts.NewHead.Mesh.Parent = C.Head
			end

			if bike.Misc.Anims.R6.Head.Parts.NewHead:FindFirstChild("face") then
				bike.Misc.Anims.R6.Head.Parts.NewHead.face.Parent = C.Head
			end

			for i,v in pairs(C:GetChildren()) do
				if v:IsA("Accessory") then		
					local Accessory = v.Handle:FindFirstChild("AccessoryWeld")
					if Accessory ~= nil and Accessory.Part1.Name == "NewHead" then
						Accessory.Part1 = C.Head
					elseif Accessory ~= nil and Accessory.Part1.Name == "Torso" then
						Accessory.Part1 = C.Torso
					end
				end
			end	
		end
