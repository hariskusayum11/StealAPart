            <Item class="ModuleScript" referent="326">
              <Properties>
                <string name="Name">Tune</string>
                <BinaryString name="AttributesSerialize">AQAAAAIAAABJRAIPAAAAQS1DaGFzc2lzIFRpcmVz</BinaryString>
                <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
                <ContentId name="LinkedSource">
